1. ESTRUCTURA BASE (EL MOLDE DE DATOS)
---------------------------------------------------------------------------
Cualquier examen te va a pedir un struct. Modificá los atributos internos.

struct Elemento {
    int id;           // Variable clave entera (DNI, nroProducto, Legajo, Fila)
    char nombre[50];  // Campo de texto (Nombre, Apellido, Tipo de Pieza)
    float valor;      // Campo decimal/flotante (Precio, Saldo, Nota, Puntos)
    int activo;       // Bandera de baja lógica: 1 = Habilitado, 0 = Borrado
};

---------------------------------------------------------------------------
2. FUNCIÓN DE INICIALIZACIÓN (Obligatoria al arrancar el main)
---------------------------------------------------------------------------
Coloca el marcador de estado en 0 (vacío/inactivo) para todo el vector.
Evita que el programa lea "basura" de la memoria antes de cargar los datos.

void inicializarArreglo(struct Elemento arr[], int max_capacidad) {
    for (int i = 0; i < max_capacidad; i++) {
        arr[i].activo = 0; // <-- TUNEAR: .activo o .habilitado según el parcial
    }
    printf("Sistema inicializado correctamente.\n");
}

---------------------------------------------------------------------------
3. ALTAS (CREAR / AGREGAR REGISTROS)
---------------------------------------------------------------------------
Pasa el contador como puntero (int *n) para modificar el valor real del main.

void agregarElemento(struct Elemento arr[], int *n, int max_capacidad) {
    if (*n >= max_capacidad) {
        printf("\nInventario/Arreglo lleno. No se puede agregar.\n");
        return;
    }

    printf("\n--- REGISTRO DE NUEVO ELEMENTO ---\n");
    
    // 1. Entero -> LLeva '&'
    printf("Ingrese el ID/DNI/Numero: ");
    scanf("%d", &arr[*n].id); // <-- TUNEAR: .id por tu entero clave

    // 2. Texto -> NO lleva '&' (Espacio antes del % para limpiar buffer)
    printf("Ingrese el Nombre/Texto: ");
    scanf(" %49[^\n]", arr[*n].nombre); // <-- TUNEAR: .nombre por tu cadena

    // 3. Flotante -> Lleva '&'
    printf("Ingrese el Precio/Valor/Saldo: ");
    scanf("%f", &arr[*n].valor); // <-- TUNEAR: .valor por tu flotante

    // 4. Inicializar Estado (Para listados y bajas lógicas)
    arr[*n].activo = 1; 

    // 5. Incrementar el contador real del main obligatoriamente
    (*n)++; 
    printf("Registro completado de forma exitosa.\n");
}

---------------------------------------------------------------------------
4. LISTADOS (MOSTRAR / LEER CON FILTROS)
---------------------------------------------------------------------------
Recorre el arreglo imprimiendo solo lo que esté visible (activo == 1).

void mostrarElementosActivos(struct Elemento arr[], int n) {
    printf("\n--- LISTADO GENERAL (ACTIVOS) ---\n");
    int encontrados = 0;

    for (int i = 0; i < n; i++) {
        // Filtrar bajas lógicas. Si está habilitado (1), se muestra
        if (arr[i].activo == 1) { 
            // TUNEAR: Ajustá los printf con las variables de tu struct
            printf("Pos: %d \t ID: %d \t Nombre: %s \t Valor: %.2f\n", 
                    i + 1, arr[i].id, arr[i].nombre, arr[i].valor);
            encontrados++;
        }
    }

    if (encontrados == 0) {
        printf("No hay registros activos para mostrar.\n");
    }
}


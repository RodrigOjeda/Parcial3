5. MODIFICACIÓN (UPDATE - COMBINADA CON BÚSQUEDA BINARIA)
---------------------------------------------------------------------------
Busca el elemento de forma veloz y, si existe y está activo, permite editar 
sus campos secundarios sin alterar el ID clave.

void modificarElemento(struct Elemento arr[], int n) {
    int idBuscado;
    printf("\nIngrese el ID/DNI del registro a MODIFICAR: ");
    scanf("%d", &idBuscado);

    // 1. Forzamos ordenamiento y buscamos la posición del casillero
    ordenarPorIdAscendente(arr, n); 
    int posicion = busquedaBinariaAscendente(arr, n, idBuscado);

    // 2. Si no existe o está dado de baja lógica, salimos
    if (posicion == -1 || arr[posicion].activo == 0) {
        printf("Error: El registro no existe o está dado de baja.\n");
        return;
    }

    // 3. Si se encuentra, procedemos a modificar los campos permitidos
    printf("Registro Encontrado. Ingrese los nuevos datos:\n");
    
    printf("Nuevo Nombre/Texto: ");
    scanf(" %49[^\n]", arr[posicion].nombre); // <-- TUNEAR campo string

    printf("Nuevo Precio/Valor: ");
    scanf("%f", &arr[posicion].valor);       // <-- TUNEAR campo float

    printf("Registro modificado con éxito.\n");
}


6. ORDENAMIENTO POR BURBUJA (VARIACIONES DE EXAMEN)
---------------------------------------------------------------------------
Intercambia bloques completos (struct aux) para evitar mezclar los datos.

OPCIÓN A: ASCENDENTE (De Menor a Mayor) por ID Numérico
void ordenarPorIdAscendente(struct Elemento arr[], int n) {
    struct Elemento aux; 
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            // CAMBIO DE CRITERIO: Signo '>' define el orden menor a mayor
            if (arr[j].id > arr[j + 1].id) { 
                aux = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = aux;
            }
        }
    }
}

OPCIÓN B: DESCENDENTE (De Mayor a Menor) por Valor/Precio Flotante
void ordenarPorValorDescendente(struct Elemento arr[], int n) {
    struct Elemento aux; 
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            // CAMBIO DE CRITERIO: Signo '<' y campo '.valor' flotante
            if (arr[j].valor < arr[j + 1].valor) { 
                aux = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = aux;
            }
        }
    }
}

OPCIÓN C: ALFABÉTICO ASCENDENTE (Por Cadenas de Texto)
void ordenarPorNombreAlfabetico(struct Elemento arr[], int n) {
    struct Elemento aux;
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            // REGLA DE EXAMEN: Las cadenas usan strcmp (Usa librería string.h)
            // Si el resultado de strcmp es > 0, significa que j va después que j+1
            if (strcmp(arr[j].nombre, arr[j + 1].nombre) > 0) {
                aux = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = aux;
            }
        }
    }
}

---------------------------------------------------------------------------
7. BÚSQUEDA BINARIA (VARIACIONES DE EXAMEN con lógica completa interna)
---------------------------------------------------------------------------
REGLA DE ORO: El vector SÍ O SÍ debe estar ordenado antes de usar esto.
Retornan la posición (índice int) en el arreglo o -1 si no existe.

OPCIÓN A: En Vector Ordenado de manera Ascendente
int busquedaBinariaAscendente(struct Elemento arr[], int n, int idBuscado) {
    int inicio = 0;
    int fin = n - 1;

    while (inicio <= fin) {
        int medio = inicio + (fin - inicio) / 2;

        // Caso de éxito: Lo encontró
        if (arr[medio].id == idBuscado) { 
            return medio; // Encontrado! Devuelve índice
        }

        // LÓGICA ASCENDENTE: Si el medio es menor, busco a la derecha
        if (arr[medio].id < idBuscado) {
            inicio = medio + 1;
        } else {
            fin = medio - 1;
        }
    }
    return -1; // No existe
}

OPCIÓN B: En Vector Ordenado de manera Descendente
int busquedaBinariaDescendente(struct Elemento arr[], int n, int idBuscado) {
    int inicio = 0;
    int fin = n - 1;

    while (inicio <= fin) {
        int medio = inicio + (fin - inicio) / 2;

        if (arr[medio].id == idBuscado) {
            return medio; 
        }

        // LÓGICA DESCENDENTE (ESPEJO): Si el medio es menor, busco a la izquierda
        if (arr[medio].id < idBuscado) {
            fin = medio - 1; 
        } else {
            inicio = medio + 1;
        }
    }
    return -1; // No existe
}


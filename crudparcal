9. ESQUELETO DEL MENU PRINCIPAL (Estructura base del main)
---------------------------------------------------------------------------
#define MAX 1000

int main() {
    struct Elemento misDatos[MAX];
    int cantidad = 0;
    int opcion;
    int idAux;
    
    // 1. Inicialización obligatoria
    inicializarArreglo(misDatos, MAX);
    
    // 2. Estructura repetitiva del menú
    do {
        printf("\n=== MENU DE OPCIONES ===");
        printf("\n1. Agregar elemento");
        printf("\n2. Listar activos");
        printf("\n3. Modificar elemento");
        printf("\n4. Buscar por ID (Binaria)");
        printf("\n5. Baja Logica");
        printf("\n6. Baja Fisica");
        printf("\n7. Salir");
        printf("\nSeleccione opcion: ");
        scanf("%d", &opcion);
        
        switch(opcion) {
            case 1:
                agregarElemento(misDatos, &cantidad, MAX);
                break;
            case 2:
                mostrarElementosActivos(misDatos, cantidad);
                break;
            case 3:
                modificarElemento(misDatos, cantidad);
                break;
            case 4:
                if (cantidad == 0) {
                    printf("No hay datos cargados.\n");
                } else {
                    printf("Ingrese ID a buscar: ");
                    scanf("%d", &idAux);
                    ordenarPorIdAscendente(misDatos, cantidad); // Requisito binaria
                    int pos = busquedaBinariaAscendente(misDatos, cantidad, idAux);
                    if(pos != -1 && misDatos[pos].activo == 1) {
                        printf("Encontrado en pos %d. Nombre: %s\n", pos+1, misDatos[pos].nombre);
                    } else {
                        printf("No encontrado o inactivo.\n");
                    }
                }
                break;
            case 5:
                if (cantidad == 0) {
                    printf("No hay datos para borrar.\n");
                } else {
                    printf("Ingrese ID para baja logica: ");
                    scanf("%d", &idAux);
                    bajaLogica(misDatos, cantidad, idAux);
                }
                break;
            case 6:
                if (cantidad == 0) {
                    printf("No hay datos para borrar.\n");
                } else {
                    printf("Ingrese ID para baja fisica: ");
                    scanf("%d", &idAux);
                    bajaFisica(misDatos, &cantidad, idAux);
                }
                break;
            case 7:
                printf("Saliendo del sistema...\n");
                break;
            default:
                printf("Opcion invalida.\n");
        }
    } while(opcion != 7);
    
    return 0;
}
